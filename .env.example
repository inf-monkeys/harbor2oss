HARBOR_URL=https://harbor.d.run
HARBOR_REGISTRY=harbor.d.run
HARBOR_PROJECT=infmonkeys
HARBOR_USER=monkey
HARBOR_PASSWORD=replace-me
HARBOR_VERIFY_TLS=false

OSS_BUCKET=inf-monkeys-2025
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_ACCESS_KEY_ID=replace-me
OSS_ACCESS_KEY_SECRET=replace-me
OSS_PREFIX=Images (backup from harbor.d.run)

KEEP_TAGS=10
CRON_SCHEDULE=0 0 * * *
RUN_ON_STARTUP=true
TZ=Asia/Shanghai
TMP_DIR=/tmp/harbor2oss
OSS_UPLOAD_THREADS=4
SKOPEO_OVERRIDE_OS=linux
SKOPEO_OVERRIDE_ARCH=amd64
LOG_LEVEL=DEBUG
