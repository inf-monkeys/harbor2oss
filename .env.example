HARBOR_URL=https://harbor.example.com
HARBOR_REGISTRY=harbor.example.com
HARBOR_PROJECT=your-project
HARBOR_USER=your-user
HARBOR_PASSWORD=replace-me
HARBOR_VERIFY_TLS=false

OSS_BUCKET=your-bucket
OSS_ENDPOINT=https://oss-cn-region.aliyuncs.com
OSS_ACCESS_KEY_ID=replace-me
OSS_ACCESS_KEY_SECRET=replace-me
OSS_PREFIX=harbor-backups

KEEP_TAGS=10
CRON_SCHEDULE=0 0 * * *
RUN_ON_STARTUP=true
TZ=Asia/Shanghai
TMP_DIR=/tmp/harbor2oss
OSS_UPLOAD_THREADS=4
NETWORK_RETRIES=3
RETRY_BASE_DELAY_SECONDS=5
HARBOR_REQUEST_TIMEOUT=60
SKOPEO_OVERRIDE_OS=linux
SKOPEO_OVERRIDE_ARCH=amd64
LOG_LEVEL=INFO
LOG_LANGUAGE=en
